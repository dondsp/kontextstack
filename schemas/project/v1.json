{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dondsp/kontextstack/schemas/project/v1.json",
  "title": "KontextStack Project Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "core", "handoff", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "project": {
      "type": "object",
      "required": ["name", "repository", "baseline"],
      "properties": {
        "name": { "type": "string" },
        "repository": { "type": "string" },
        "baseline": { "type": "object" }
      }
    },
    "core": {
      "type": "object",
      "required": ["name", "version", "source"],
      "properties": {
        "name": { "const": "KontextStack" },
        "version": { "type": "string" },
        "source": { "const": "https://github.com/dondsp/kontextstack" },
        "commit": { "type": ["string", "null"] }
      }
    },
    "handoff": {
      "type": "object",
      "required": ["artifactId", "contentHash"],
      "properties": {
        "artifactId": { "type": "string" },
        "contentHash": { "type": "string" },
        "schema": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "sourceTrack": { "type": "string" },
        "architecture": { "type": "object" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
