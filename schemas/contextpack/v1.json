{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextkraft.com/schemas/contextpack/v1",
  "title": "Reconciled ContextPack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "artifactType",
    "artifactId",
    "projectId",
    "createdAt",
    "createdBy",
    "sources",
    "freshness",
    "contentHash",
    "intent",
    "observed",
    "decisions"
  ],
  "properties": {
    "schema": { "const": "https://contextkraft.com/schemas/contextpack/v1" },
    "schemaVersion": { "const": "1.0.0" },
    "artifactType": { "enum": ["intent-contextpack", "reconciled-contextpack"] },
    "artifactId": { "$ref": "#/$defs/nonEmptyString" },
    "projectId": { "$ref": "#/$defs/nonEmptyString" },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "$ref": "#/$defs/creator" },
    "sources": { "type": "array", "items": { "type": "object" } },
    "freshness": { "type": "object" },
    "contentHash": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" },
    "intent": { "type": "object" },
    "observed": { "type": "object" },
    "decisions": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "enum": ["user", "contextkraft", "coding-agent", "kontextstack"] },
        "name": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
