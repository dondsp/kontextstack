{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dondsp/kontextstack/schemas/installation/v1.json",
  "title": "KontextStack Installation Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "canonicalSource",
    "cloneUrl",
    "minimumNodeMajor",
    "packageManager",
    "sharedCommands",
    "modes"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "name": { "type": "string", "minLength": 1 },
    "canonicalSource": { "const": "https://github.com/dondsp/kontextstack" },
    "cloneUrl": { "const": "https://github.com/dondsp/kontextstack.git" },
    "minimumNodeMajor": { "type": "integer", "minimum": 20 },
    "packageManager": { "const": "npm" },
    "sharedCommands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simple", "mature"],
      "properties": {
        "simple": { "$ref": "#/$defs/mode" },
        "mature": { "$ref": "#/$defs/mode" }
      }
    }
  },
  "$defs": {
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description",
        "verificationProfile",
        "verifyCommand",
        "firstCommand",
        "projectSignals",
        "safeguards"
      ],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "verificationProfile": { "enum": ["core", "extended"] },
        "verifyCommand": { "type": "string", "minLength": 1 },
        "firstCommand": { "type": "string", "minLength": 1 },
        "projectSignals": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "safeguards": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
