{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dondsp/kontextstack/schemas/module/registry-v1.json",
  "title": "KontextStack Module Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "canonicalSource", "modules"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "canonicalSource": { "const": "https://github.com/dondsp/kontextstack" },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "versions"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "versions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/version" } }
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "coreCompatibility", "manifestPath", "integrity", "publishedAt", "status"],
      "properties": {
        "version": { "type": "string" },
        "coreCompatibility": { "type": "string" },
        "manifestPath": { "type": "string" },
        "integrity": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["alpha", "stable", "deprecated", "revoked"] }
      }
    }
  }
}
