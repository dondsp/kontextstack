{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dondsp/kontextstack/schemas/module/v1.json",
  "title": "KontextStack Module Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "displayName",
    "version",
    "description",
    "category",
    "maturity",
    "projectTypes",
    "coreCompatibility",
    "source",
    "dependencies",
    "optionalDependencies",
    "conflicts",
    "capabilities",
    "permissions",
    "files",
    "validations",
    "upgrade"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "minLength": 1 },
    "category": { "enum": ["handoff", "workflow", "hosting", "runtime", "storage", "identity", "delivery", "operations"] },
    "maturity": { "type": "array", "items": { "enum": [0, 1, 2, 3] }, "uniqueItems": true },
    "projectTypes": { "type": "array", "items": { "enum": ["website", "web-app", "service", "unknown"] }, "uniqueItems": true },
    "coreCompatibility": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "path", "integrity"],
      "properties": {
        "repository": { "const": "https://github.com/dondsp/kontextstack" },
        "ref": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^modules/[a-z0-9-]+$" },
        "integrity": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" }
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "optionalDependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "conflicts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "capabilities": { "type": "array", "items": { "enum": ["docs", "templates", "validation"] }, "uniqueItems": true },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "commands", "writePatterns"],
      "properties": {
        "network": { "const": false },
        "commands": { "type": "array", "maxItems": 0 },
        "writePatterns": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "template"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "template": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "source"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "pattern": "^files/" }
            }
          }
        ]
      }
    },
    "validations": { "type": "array", "items": { "type": "object" } },
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "strategy"],
      "properties": {
        "from": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "strategy": { "const": "preview-required" }
      }
    }
  }
}
